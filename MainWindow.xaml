<Window x:Class="ScreenAutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Monitor"
        Icon="icon.ico"
        Width="1020" Height="650"
        MinWidth="700" MinHeight="480"
        Background="White"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Green Start button -->
        <Style x:Key="GreenButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#218838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A3D9B1"/>
                                <Setter Property="BorderBrush" Value="#A3D9B1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Stop button -->
        <Style x:Key="RedButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C82333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BD2130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1A9B0"/>
                                <Setter Property="BorderBrush" Value="#F1A9B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline/Gray button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E4E4E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log ListBoxItem style -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat TabControl -->
        <Style x:Key="FlatTabControl" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F7F7"
                                    BorderBrush="#DDDDDD" BorderThickness="1,1,1,0">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1,0,1,1" Background="White">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat TabItem -->
        <Style x:Key="FlatTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="#DDDDDD"
                                BorderThickness="0,0,1,0"
                                Padding="16,7">
                            <TextBlock x:Name="HeaderText"
                                       Text="{TemplateBinding Header}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White"/>
                                <Setter TargetName="Root" Property="Margin" Value="0,0,0,-1"/>
                                <Setter TargetName="Root" Property="Padding" Value="16,7,16,8"/>
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#222222"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#EEEEEE"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="22,16,22,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Log Monitor" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Zaženi ali ustavi spremljanje procesa in poglej izpis loga."
                           FontSize="12" Foreground="#777777" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SettingsButton"
                        Style="{StaticResource OutlineButton}"
                        Click="SettingsButton_Click"
                        Margin="0,0,0,5" MinWidth="160">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2699;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nastavitve" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearButton"
                        Style="{StaticResource OutlineButton}"
                        Click="ClearButton_Click"
                        Margin="0,0,0,5" MinWidth="160">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5D1;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Počisti log" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TablesButton"
                        Style="{StaticResource OutlineButton}"
                        Click="TablesButton_Click"
                        MinWidth="160">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x229E;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tabele podatkov" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Separator ── -->
        <Rectangle Grid.Row="1" Height="1" Fill="#E0E0E0"/>

        <!-- ── Controls row ── -->
        <Grid Grid.Row="2" Margin="22,12,22,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton"
                        Style="{StaticResource GreenButton}"
                        Margin="0,0,8,0"
                        Click="StartButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Start" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton"
                        Style="{StaticResource RedButton}"
                        IsEnabled="False"
                        Margin="0,0,28,0"
                        Click="StopButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25A0;" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Status indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status:" FontSize="13" Foreground="#666666"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="11" Height="11"
                             Fill="#6C757D" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ustavljeno"
                               FontSize="13" Foreground="#555555" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- ── Main content: tabs (left) + sidebar (right) ── -->
        <Grid Grid.Row="3" Margin="22,0,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- Tab Control -->
            <TabControl x:Name="MainTabControl" Grid.Column="0"
                        Style="{StaticResource FlatTabControl}">

                <!-- Log Tab -->
                <TabItem Header="Log" Style="{StaticResource FlatTabItem}">
                    <ListBox x:Name="LogListBox"
                             BorderThickness="0"
                             Background="White"
                             ItemContainerStyle="{StaticResource LogItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimestampText}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#666666" Width="195"/>
                                    <TextBlock Text="{Binding LevelTag}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{Binding LevelBrush}"
                                               FontWeight="Bold" Width="78"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#222222"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <!-- Table 1 Tab -->
                <TabItem Header="OTROCI" Style="{StaticResource FlatTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FAFAFA"
                                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#x21BB;  Osveži" Click="RefreshTable1_Click"
                                        Style="{StaticResource OutlineButton}"/>
                                <TextBlock x:Name="Table1Status" Text=""
                                           FontSize="12" Foreground="#888888"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="Table1Grid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  AlternatingRowBackground="#FAFAFA"
                                  Background="White" BorderThickness="0"
                                  FontFamily="Segoe UI" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ime" Binding="{Binding ContactName}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Koda" Binding="{Binding Code}" Width="130"/>
                                <DataGridTextColumn Header="Tip karte" Binding="{Binding CardType}" Width="185"/>
                                <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsActive">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,2" Margin="2,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#721C24"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#155724"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Veljavna do" Binding="{Binding ValidTo}" Width="100" SortMemberPath="ValidToDate"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Table 2 Tab -->
                <TabItem Header="ODRASLI" Style="{StaticResource FlatTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FAFAFA"
                                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#x21BB;  Osveži" Click="RefreshTable2_Click"
                                        Style="{StaticResource OutlineButton}"/>
                                <TextBlock x:Name="Table2Status" Text=""
                                           FontSize="12" Foreground="#888888"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="Table2Grid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  AlternatingRowBackground="#FAFAFA"
                                  Background="White" BorderThickness="0"
                                  FontFamily="Segoe UI" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ime" Binding="{Binding ContactName}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Koda" Binding="{Binding Code}" Width="130"/>
                                <DataGridTextColumn Header="Tip karte" Binding="{Binding CardType}" Width="185"/>
                                <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsActive">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,2" Margin="2,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#721C24"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#155724"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Veljavna do" Binding="{Binding ValidTo}" Width="100" SortMemberPath="ValidToDate"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Right sidebar -->
            <Border Grid.Column="1" Margin="10,0,0,0"
                    BorderBrush="#DDDDDD" BorderThickness="1"
                    CornerRadius="4" Padding="14"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Tabele podatkov" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="Odpri tabelo podatkov za pregled in filtriranje."
                               TextWrapping="Wrap" FontSize="12" Foreground="#777777" Margin="0,5,0,14"/>
                    <Button Click="OpenTable1_Click" Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x229E;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Odpri OTROCI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OpenTable2_Click" Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x229E;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Odpri ODRASLI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="4" Background="#F5F5F5"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="22,6">
                <TextBlock Text="Verzija: 1.0.0.0"
                           FontSize="11" Foreground="#999999"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ClockText"
                           FontSize="11" Foreground="#999999"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
