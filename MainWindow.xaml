<Window x:Class="ScreenAutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Monitor"
        Width="1020" Height="650"
        MinWidth="700" MinHeight="480"
        Background="White"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Green Start button -->
        <Style x:Key="GreenButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#218838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A3D9B1"/>
                                <Setter Property="BorderBrush" Value="#A3D9B1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Stop button -->
        <Style x:Key="RedButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C82333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BD2130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1A9B0"/>
                                <Setter Property="BorderBrush" Value="#F1A9B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline/Gray button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E4E4E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log ListBoxItem style -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="22,16,22,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Log Monitor" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Zaženi ali ustavi spremljanje procesa in poglej izpis loga."
                           FontSize="12" Foreground="#777777" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="SettingsButton"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource OutlineButton}"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2699;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Nastavitve" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── Separator ── -->
        <Rectangle Grid.Row="1" Height="1" Fill="#E0E0E0"/>

        <!-- ── Controls row ── -->
        <Grid Grid.Row="2" Margin="22,12,22,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton"
                        Style="{StaticResource GreenButton}"
                        Margin="0,0,8,0"
                        Click="StartButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Start" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton"
                        Style="{StaticResource RedButton}"
                        IsEnabled="False"
                        Margin="0,0,28,0"
                        Click="StopButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25A0;" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Status indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status:" FontSize="13" Foreground="#666666"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="11" Height="11"
                             Fill="#6C757D" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ustavljeno"
                               FontSize="13" Foreground="#555555" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="ClearButton"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource OutlineButton}"
                    Click="ClearButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Počisti log" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── Log area with tab ── -->
        <Grid Grid.Row="3" Margin="22,0,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab strip -->
            <Border Grid.Row="0" Background="#F7F7F7"
                    BorderBrush="#DDDDDD" BorderThickness="1,1,1,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" BorderBrush="#DDDDDD"
                            BorderThickness="0,0,1,0" Padding="16,7">
                        <TextBlock Text="Log" FontSize="13" FontWeight="SemiBold" Foreground="#222"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Log content -->
            <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1,0,1,1">
                <ListBox x:Name="LogListBox"
                         BorderThickness="0"
                         Background="White"
                         ItemContainerStyle="{StaticResource LogItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimestampText}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#666666" Width="195"/>
                                <TextBlock Text="{Binding LevelTag}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{Binding LevelBrush}"
                                           FontWeight="Bold" Width="78"/>
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#222222"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="4" Background="#F5F5F5"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="22,6">
                <TextBlock Text="Verzija: 1.0.0.0"
                           FontSize="11" Foreground="#999999"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ClockText"
                           FontSize="11" Foreground="#999999"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
