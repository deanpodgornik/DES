  <ClickY>546</ClickY>

  <!-- Pot do slike, ki jo iščemo -->
  <TemplateImagePath>template.png</TemplateImagePath>

  <!-- Interval preverjanja v milisekundah (3000 = 3 sekunde) -->
  <CheckIntervalMs>1000</CheckIntervalMs>

  <!-- Tolerance za ujemanje slik (0-255, nižje = bolj natančno) -->
  <MatchTolerance>30</MatchTolerance>

  <!-- Debug mode - shrani screenshote za analizo (true/false) -->
  <DebugMode>true</DebugMode>

  <!-- Uporabi config-debug.xml kot konfiguracijo, ko je DebugMode=true (true/false) -->
  <UseDebugConfigFile>true</UseDebugConfigFile>

  <!-- Zamik pred klikom po ujemanju v milisekundah (3000 = 3 sekunde) -->
  <ClickDelayMs>3000</ClickDelayMs>

  <!-- OCR: branje številk z zaslona (true/false) -->
