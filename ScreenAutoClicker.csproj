<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.xml" CopyToPublishDirectory="Always" />
    <None Include="config-debug.xml" CopyToPublishDirectory="Always" />
    <None Include="config.example.xml" CopyToPublishDirectory="Always" />
    <None Include="template.png" CopyToPublishDirectory="Always" />
    <None Include="template-not-valid.png" CopyToPublishDirectory="Always" />
    <None Include="template-debug.png" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
