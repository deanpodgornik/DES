<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>4.2.0</Version>
    <AssemblyVersion>4.2.0</AssemblyVersion>
    <FileVersion>4.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <None Include="config.xml" CopyToPublishDirectory="Always" />
    <None Include="config-debug.xml" CopyToPublishDirectory="Always" />
    <None Include="config.example.xml" CopyToPublishDirectory="Always" />
    <None Include="template.png" CopyToPublishDirectory="Always" />
    <None Include="template-not-valid.png" CopyToPublishDirectory="Always" />
    <None Include="template-debug.png" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
