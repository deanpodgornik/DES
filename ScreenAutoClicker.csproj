<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tessdata\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyTesseractNativeDlls" AfterTargets="Publish">
    <ItemGroup>
      <TesseractX64 Include="$(NuGetPackageRoot)tesseract\5.2.0\x64\*" />
      <TesseractX86 Include="$(NuGetPackageRoot)tesseract\5.2.0\x86\*" />
      <TesseractData Include="$(MSBuildProjectDirectory)\tessdata\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TesseractX64)" DestinationFolder="$(PublishDir)x64\" />
    <Copy SourceFiles="@(TesseractX86)" DestinationFolder="$(PublishDir)x86\" />
    <Copy SourceFiles="@(TesseractData)" DestinationFolder="$(PublishDir)tessdata\" />
  </Target>

</Project>
