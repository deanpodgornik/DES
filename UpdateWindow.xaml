<Window x:Class="ScreenAutoClicker.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posodobitev na voljo"
        Width="500" Height="420"
        MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Na voljo je nova različica!"
                       FontSize="17" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock x:Name="VersionText"
                       FontSize="13" Foreground="#555555" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Height="1" Fill="#E0E0E0" Margin="0,0,0,12"/>

        <!-- Release notes -->
        <GroupBox Grid.Row="2" Header="Spremembe" Margin="0,0,0,14"
                  FontSize="12" Foreground="#333333">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2">
                <TextBlock x:Name="ReleaseNotesText"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="#222222" Padding="6,4"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Download progress (hidden until update starts) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16"
                    x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText"
                       FontSize="12" Foreground="#555555" Margin="0,0,0,5"/>
            <ProgressBar x:Name="UpdateProgressBar"
                         Height="14" Minimum="0" Maximum="100"
                         Background="#EEEEEE" Foreground="#0078D4"
                         BorderThickness="0"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Content="Prekliči"
                    Width="90" Padding="0,8"
                    FontSize="13"
                    Click="Cancel_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="UpdateBtn"
                    Content="Posodobi zdaj"
                    Width="140" Padding="0,8"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White" BorderThickness="0"
                    Cursor="Hand"
                    Click="Update_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#006CBE"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#005FAD"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#B3D4F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
